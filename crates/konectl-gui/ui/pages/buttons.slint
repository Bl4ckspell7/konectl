// The Buttons page: the function of each button, in both layers.
import { Button, ComboBox, LineEdit, Palette, SpinBox } from "std-widgets.slint";
import { ButtonPage, ButtonView } from "../globals/buttons.slint";
import { Theme } from "../globals/theme.slint";
import { Group, Row } from "../components/widgets/group.slint";
import { MouseDiagram } from "../components/mouse-diagram.slint";

// A row of the button list: number, name, function.
component ButtonRow inherits Rectangle {
    in property <ButtonView> view;
    in property <bool> selected;
    callback clicked();

    min-height: 30px;
    border-radius: 6px;
    background: root.selected ? Palette.selection-background
        : touch.has-hover ? Palette.control-background : transparent;
    accessible-role: list-item;
    accessible-label: "Button " + root.view.number + ", " + root.view.name + ": " + root.view.function;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        Text {
            text: root.view.number;
            min-width: 14px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.selected ? Palette.selection-foreground : Palette.foreground;
        }

        Text {
            text: root.view.name;
            min-width: 130px;
            vertical-alignment: center;
            color: root.selected ? Palette.selection-foreground : Theme.muted;
        }

        Text {
            text: root.view.function;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
            color: root.selected ? Palette.selection-foreground : Palette.foreground;
        }
    }
}

// Writes the macro, after asking when other profiles play it too.
component MacroWrite {
    in property <bool> idle;

    HorizontalLayout {
        alignment: end;

        Button {
            text: "Write macro";
            primary: true;
            enabled: root.idle && ButtonPage.macro-keys != "" && ButtonPage.macro-problem == "";
            clicked => {
                if ButtonPage.macro-shared != "" {
                    confirm.show();
                } else {
                    ButtonPage.write-macro();
                }
            }
        }
    }

    confirm := PopupWindow {
        x: root.width - 380px;
        y: -self.height - 6px;
        width: 380px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Replace the macro of " + ButtonPage.macro-shared + "?";
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: "The mouse keeps one macro per button for all profiles, so " + ButtonPage.macro-shared + " will play the new one too. The old keys cannot be read back.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing;

                    Button {
                        text: "Cancel";
                        clicked => {
                            confirm.close();
                        }
                    }

                    Button {
                        text: "Replace";
                        primary: true;
                        enabled: root.idle;
                        clicked => {
                            confirm.close();
                            ButtonPage.write-macro();
                        }
                    }
                }
            }
        }
    }
}

export component ButtonsPage {
    in property <bool> idle;
    property <[string]> names: ["Left button", "Right button", "Wheel click", "Wheel up", "Wheel down", "Side button, front", "Side button, rear", "Profile button"];
    property <length> label-width: 90px;

    HorizontalLayout {
        spacing: Theme.padding;

        Group {
            title: "Buttons";
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: Theme.spacing;

                Button {
                    text: "Standard";
                    primary: !ButtonPage.easy-shift;
                    clicked => {
                        ButtonPage.show-layer(false);
                    }
                }

                Button {
                    text: "Easy-Shift";
                    primary: ButtonPage.easy-shift;
                    clicked => {
                        ButtonPage.show-layer(true);
                    }
                }
            }

            Text {
                text: ButtonPage.easy-shift
                    ? "While an Easy-Shift button is held."
                    : "Normally.";
                font-size: 12px;
                color: Theme.muted;
            }

            HorizontalLayout {
                alignment: center;

                MouseDiagram {
                    selected: ButtonPage.button;
                    names: root.names;
                    select(number) => {
                        ButtonPage.select(number);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Theme.padding;
            horizontal-stretch: 1;
            min-width: 420px;

            Group {
                title: ButtonPage.easy-shift ? "Functions with Easy-Shift" : "Functions";

                for view in ButtonPage.buttons: ButtonRow {
                    view: view;
                    selected: view.number == ButtonPage.button;
                    clicked => {
                        ButtonPage.select(view.number);
                    }
                }
            }

            Group {
                title: ButtonPage.title;

                Row {
                    label: "Now";
                    label-width: root.label-width;

                    Text {
                        text: ButtonPage.current;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                if ButtonPage.note != "": Text {
                    text: ButtonPage.note;
                    wrap: word-wrap;
                    color: Theme.muted;
                }

                if ButtonPage.groups.length > 0: Row {
                    label: "Function";
                    label-width: root.label-width;

                    ComboBox {
                        accessible-label: "Kind of function";
                        model: ButtonPage.groups;
                        current-index <=> ButtonPage.group;
                        enabled: root.idle;
                        max-height: self.min-height;
                        selected => {
                            ButtonPage.choose-group(self.current-index);
                        }
                    }
                }

                if ButtonPage.kind == "list": Row {
                    label: "";
                    label-width: root.label-width;

                    ComboBox {
                        accessible-label: "Function";
                        model: ButtonPage.functions;
                        current-index <=> ButtonPage.function;
                        enabled: root.idle;
                        max-height: self.min-height;
                        selected => {
                            ButtonPage.choose-function(self.current-index);
                        }
                    }
                }

                if ButtonPage.kind == "key": VerticalLayout {
                    spacing: Theme.spacing;

                    Row {
                        label: "Key";
                        label-width: root.label-width;

                        LineEdit {
                            accessible-label: "Key";
                            text <=> ButtonPage.key;
                            placeholder-text: "ctrl+c";
                            enabled: root.idle;
                            edited(text) => {
                                ButtonPage.check-key(text);
                            }
                            accepted(text) => {
                                ButtonPage.set-key(text);
                            }
                        }

                        Button {
                            text: "Set";
                            enabled: root.idle && ButtonPage.key != "" && ButtonPage.key-problem == "";
                            clicked => {
                                ButtonPage.set-key(ButtonPage.key);
                            }
                        }
                    }

                    Text {
                        text: ButtonPage.key-problem != "" ? ButtonPage.key-problem
                            : "A key with modifiers: ctrl+c, shift+alt+f5, home, or modifiers alone: ctrl.";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: ButtonPage.key-problem != "" ? Theme.error-text : Theme.muted;
                    }
                }

                if ButtonPage.kind == "easy-aim": Row {
                    label: "DPI";
                    label-width: root.label-width;

                    SpinBox {
                        minimum: 100;
                        maximum: 19000;
                        step-size: 50;
                        value <=> ButtonPage.easy-aim-dpi;
                        enabled: root.idle;
                    }

                    Button {
                        text: "Set";
                        enabled: root.idle;
                        clicked => {
                            ButtonPage.set-easy-aim(ButtonPage.easy-aim-dpi);
                        }
                    }
                }

                if ButtonPage.kind == "macro": VerticalLayout {
                    spacing: Theme.spacing;

                    Row {
                        label: "Keys";
                        label-width: root.label-width;

                        LineEdit {
                            accessible-label: "Macro keys";
                            text <=> ButtonPage.macro-keys;
                            placeholder-text: "ctrl+c, 50ms, ctrl+v";
                            enabled: root.idle;
                            edited(text) => {
                                ButtonPage.check-macro(text);
                            }
                        }
                    }

                    Text {
                        text: ButtonPage.macro-problem != "" ? ButtonPage.macro-problem
                            : "Keys with modifiers, down:KEY and up:KEY, and pauses such as 50ms (20 ms between keys otherwise), separated by commas; at most 100 key events.";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: ButtonPage.macro-problem != "" ? Theme.error-text : Theme.muted;
                    }

                    Row {
                        label: "Plays";
                        label-width: root.label-width;

                        ComboBox {
                            accessible-label: "How the macro plays";
                            model: ButtonPage.macro-modes;
                            current-index <=> ButtonPage.macro-mode;
                            enabled: root.idle;
                            max-height: self.min-height;
                        }

                        if ButtonPage.macro-mode == 1: SpinBox {
                            minimum: 2;
                            maximum: 99;
                            value <=> ButtonPage.macro-repeat;
                            enabled: root.idle;
                        }

                        if ButtonPage.macro-mode == 1: Text {
                            text: "times";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "The mouse cannot report a macro's keys, so they cannot be shown or undone; Undo only gives the button its old function back.";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.muted;
                    }

                    MacroWrite {
                        idle: root.idle;
                    }
                }
            }
        }
    }
}

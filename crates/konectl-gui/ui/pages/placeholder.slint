// A page whose controls are not there yet.
import { Theme } from "../globals/theme.slint";
import { Group } from "../components/widgets/group.slint";

export component PlaceholderPage {
    in property <string> title;

    VerticalLayout {
        alignment: start;

        Group {
            title: root.title;

            Text {
                text: "These settings cannot be changed here yet. Use the konectl command for now.";

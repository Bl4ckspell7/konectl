    out property <string> left-light: "M 202 0 L 174 0 L 147 3 L 120 9 L 101 15 L 89 21 L 85 24 L 76 36 L 67 54 L 56 84 L 56 87 L 51 102 L 47 120";
    out property <string> right-light: "M 202 0 L 247 3 L 276 9 L 311 21 L 327 33 L 333 42 L 337 51 L 341 63 L 343 66 L 343 69 L 349 87 L 356 117 L 357 120";
    out property <float> light-full: 120;
    out property <float> light-end: 195;
    // Where the front buttons end, and the gap between them.
    out property <string> lines: "M 202 2 L 202 313 M 23 313 L 360 313";
    out property <float> split-x: 202;

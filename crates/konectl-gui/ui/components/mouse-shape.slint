    // The two front buttons, down to where they end.
    out property <string> left-button: "M 202 0 L 174 0 L 147 3 L 120 9 L 101 15 L 89 21 L 85 24 L 76 36 L 67 54 L 56 84 L 56 87 L 51 102 L 39 153 L 31 201 L 31 207 L 25 228 L 25 261 L 24 264 L 25 303 L 23 312 L 202 313 Z";
    out property <string> right-button: "M 202 0 L 247 3 L 276 9 L 311 21 L 327 33 L 333 42 L 337 51 L 341 63 L 343 66 L 343 69 L 349 87 L 356 117 L 361 147 L 364 177 L 364 234 L 363 237 L 363 249 L 359 288 L 358 313 L 202 313 Z";
    // The lit front parts of the two buttons: their outer edge from the gap

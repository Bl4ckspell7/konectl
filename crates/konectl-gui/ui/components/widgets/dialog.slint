// Parts of the dialogs: the frame inside a PopupWindow, and notes.
import { Palette } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";

// The frame of a dialog: title, then the content and its buttons.
export component DialogFrame inherits Rectangle {
    in property <string> title;

    background: Palette.background;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Palette.border;
    drop-shadow-blur: 10px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: root.title;
            font-weight: 600;
            wrap: word-wrap;
        }

        @children
    }
}

// An explanation under a control.
export component Note inherits Text {
    font-size: 12px;
    color: Theme.muted;
    wrap: word-wrap;
}

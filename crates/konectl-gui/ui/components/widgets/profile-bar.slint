// The profiles in use: which one the page shows and which one is active, and
// one menu to activate, add, colour and remove them.
import { Button, Palette } from "std-widgets.slint";
import { AppState, MouseState, ProfileView } from "../../globals/app-state.slint";
import { Theme } from "../../globals/theme.slint";
import { ColorButton } from "color-picker.slint";

component ProfileChip inherits Rectangle {
    in property <ProfileView> profile;
    in property <bool> selected;
    callback clicked();

    min-height: 32px;
    max-height: 32px;
    border-radius: 16px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Palette.accent-background : Palette.border;
    background: touch.has-hover ? Palette.control-background : transparent;
    accessible-role: tab;
    accessible-label: "Profile " + root.profile.number + (root.profile.active ? ", active" : "");
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                min-width: 12px;
                max-width: 12px;
                min-height: 12px;
                max-height: 12px;
                border-radius: 6px;
                background: root.profile.has-color ? root.profile.color : transparent;
                border-width: 1px;
                border-color: Palette.border;
            }
        }

        Text {
            text: root.profile.number;
            vertical-alignment: center;
            font-weight: root.selected ? 600 : 400;
        }

        if root.profile.active: Text {
            text: "active";
            font-size: 11px;
            color: Palette.accent-background;
            vertical-alignment: center;
        }
    }
}

// An entry of the profile menu.
component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-height: 32px;
    max-height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Palette.control-background : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? Palette.foreground : Theme.muted;
        }
    }
}

export component ProfileBar {
    in property <ProfileView> selected;
    property <bool> idle: !AppState.busy && AppState.state == MouseState.connected;

    // Only its picker is used, opened from the menu.
    colour := ColorButton {
        x: root.width - self.width;
        y: (root.height - self.height) / 2;
        swatch-hidden: true;
        label: "Profile colour";
        popup-x: self.width - 256px;
        color: root.selected.color;
        has-color: root.selected.has-color;
        allow-none: true;
        enabled: root.idle;
        picked(chosen) => {
            AppState.set-profile-color(AppState.profile, chosen);
        }
        cleared => {
            AppState.clear-profile-color(AppState.profile);
        }
    }

    HorizontalLayout {
        spacing: Theme.spacing;

        Text {
            text: "Profile";
            color: Theme.muted;
            vertical-alignment: center;
        }

        for profile in AppState.profiles: ProfileChip {
            horizontal-stretch: 0;
            profile: profile;
            selected: profile.number == AppState.profile;
            clicked => {
                AppState.profile = profile.number;
                AppState.profile-selected(profile.number);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        menu-button := Button {
            text: "Profile ▾";
            enabled: root.idle;
            clicked => {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 240px;
        y: root.height + 4px;
        width: 240px;
        close-policy: close-on-click;

        Rectangle {
            background: Palette.background;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow;

            VerticalLayout {
                padding: 4px;

                MenuEntry {
                    text: root.selected.active ? "Profile " + AppState.profile + " is active" : "Activate profile " + AppState.profile;
                    enabled: root.idle && !root.selected.active;
                    clicked => {
                        AppState.activate-profile(AppState.profile);
                    }
                }

                MenuEntry {
                    text: "Add a copy of profile " + AppState.profile;
                    enabled: root.idle && AppState.profiles.length < 5;
                    clicked => {
                        AppState.add-profile(AppState.profile);
                    }
                }

                MenuEntry {
                    text: "Colour …";
                    enabled: root.idle;
                    clicked => {
                        colour.open();
                    }
                }

                MenuEntry {
                    text: "Remove profile " + AppState.profile + " …";
                    enabled: root.idle && !root.selected.active && AppState.profiles.length > 1;
                    clicked => {
                        confirm.show();
                    }
                }
            }
        }
    }

    confirm := PopupWindow {
        x: root.width - 380px;
        y: root.height + 6px;
        width: 380px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Palette.background;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Remove profile " + AppState.profile + "?";
                    font-weight: 600;
                }

                Text {
                    text: "Its settings are lost. The profiles after it move down one slot, and buttons that switch to it are disabled. Undo brings it back.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.spacing;

                    Button {
                        text: "Cancel";
                        clicked => {
                            confirm.close();
                        }
                    }

                    Button {
                        text: "Remove";
                        primary: true;
                        clicked => {
                            confirm.close();
                            AppState.remove-profile(AppState.profile);
                        }
                    }
                }
            }
        }
    }
}

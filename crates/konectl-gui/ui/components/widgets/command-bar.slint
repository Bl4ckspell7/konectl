// The konectl command line that makes the same change as the last one.
import { Button, Palette } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";

export component CommandBar inherits Rectangle {
    in property <string> commands;

    background: Theme.sidebar;

    Rectangle {
        y: 0;
        height: 1px;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: Theme.spacing;

        Text {
            text: "CLI";
            font-weight: 600;
            color: Theme.muted;
            vertical-alignment: center;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            lines := TextInput {
                text: root.commands != "" ? root.commands : "The command for each change shows here.";
                color: root.commands != "" ? Palette.foreground : Theme.muted;
                read-only: true;
                single-line: false;
                font-family: "monospace";
                font-size: 12px;
            }
        }

        VerticalLayout {
            alignment: center;

            Button {
                text: "Copy";
                enabled: root.commands != "";
                clicked => {
                    lines.select-all();
                    lines.copy();
                    lines.clear-selection();
                }
            }
        }
    }
}

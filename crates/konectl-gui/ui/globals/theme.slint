// Sizes and the few colours the std-widgets palette has no name for. Colours
// follow the light or dark scheme of the desktop.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <length> spacing: 8px;
    out property <length> padding: 16px;
    out property <length> radius: 8px;
    out property <length> sidebar-width: 208px;
    out property <length> label-width: 150px;

    out property <brush> sidebar: Palette.alternate-background;
    out property <brush> card: Palette.background;
    out property <brush> muted: Palette.foreground.transparentize(35%);

    out property <brush> info-background: dark ? #1c3a5e : #dbeafe;
    out property <brush> warning-background: dark ? #4a3b12 : #fdf0d5;
    out property <brush> error-background: dark ? #4b1c1c : #fbe0e0;
    out property <brush> error-text: dark ? #ff8a8a : #c01c28;
    // Under popups.
    out property <color> shadow: dark ? #00000080 : #00000040;

    // The mouse drawings.
    out property <brush> mouse-body: dark ? #26282c : #dfe2e6;
    out property <brush> mouse-part: dark ? #3a3d42 : #f3f4f6;
    out property <brush> mouse-part-hover: dark ? #4a4e55 : #ffffff;
    out property <brush> mouse-line: dark ? #3a3d42 : #c3c7cd;
    out property <brush> mouse-part-border: dark ? #6a6e75 : #9aa0a8;
}

// State shared by all pages, set from Rust (`src/ui/app.rs`).

// What the app knows about the mouse.
export enum MouseState {
    // No mouse found (or opening it failed: see `problem`).
    searching,
    // A mouse is connected, but this user may not open it.
    no-access,
    // The dongle is connected, the mouse does not answer.
    asleep,
    connected,
}

// The mouse as shown on the Device page and in the sidebar.
export struct DeviceView {
    connection: string,
    firmware: string,
    battery: string,
    // 0–1, or below 0 when unknown.
    battery-level: float,
    signal: string,
    profiles: string,
    energy-saving: string,
}

// A profile in the profile bar.
export struct ProfileView {
    number: int,
    color: color,
    has-color: bool,
    active: bool,
}

// A colour typed as text, if it is one.
export struct ParsedColor {
    valid: bool,
    color: color,
}

export global AppState {
    in property <MouseState> state: MouseState.searching;
    // The pages have data: connected, or asleep after being connected.
    in property <bool> has-snapshot;
    in property <DeviceView> device;
    // Why no mouse could be used, if it is not simply unplugged.
    in property <string> problem;
    in property <bool> busy;
    in property <string> busy-text;
    in-out property <string> error;
    in property <bool> changed-elsewhere;
    in property <bool> in-flatpak;
    // The commands that install the udev rule in a terminal.
    in property <string> manual-commands;
    in property <bool> demo;

    in-out property <int> page;

    // The profiles in use, and the one the pages show and change.
    in property <[ProfileView]> profiles;
    in-out property <int> profile;
    in property <ProfileView> selected-profile;
    // What the last change did, or a note on it.
    in property <string> message;
    // The same change with the CLI.
    in property <string> commands;
    in property <bool> can-undo;

    callback reload();
    callback retry();
    callback allow-access();
    callback profile-selected(int);
    callback activate-profile(int);
    callback add-profile(int);
    callback remove-profile(int);
    callback set-profile-color(int, color);
    callback clear-profile-color(int);
    callback undo();
    pure callback parse-color(string) -> ParsedColor;

    public function dismiss-error() {
        self.error = "";
    }
}

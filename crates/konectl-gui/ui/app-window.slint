// The main window: sidebar, page title with banners, the page, status bar.
import { Button, Palette, ScrollView } from "std-widgets.slint";
import { AppState, MouseState, DeviceView, ParsedColor, ProfileView } from "globals/app-state.slint";
import { Lighting } from "globals/lighting.slint";
import { Performance, StageView } from "globals/performance.slint";
import { Theme } from "globals/theme.slint";
import { Sidebar } from "components/widgets/sidebar.slint";
import { Banner, BannerKind } from "components/widgets/banner.slint";
import { CommandBar } from "components/widgets/command-bar.slint";
import { ProfileBar } from "components/widgets/profile-bar.slint";
import { StatusBar } from "components/widgets/status-bar.slint";
import { AccessPage } from "pages/access.slint";
import { DevicePage } from "pages/device.slint";
import { LightingPage } from "pages/lighting.slint";
import { PerformancePage } from "pages/performance.slint";
import { PlaceholderPage } from "pages/placeholder.slint";
import { StatePage } from "pages/state.slint";

export { AppState, MouseState, DeviceView, ParsedColor, ProfileView, Lighting, Performance, StageView }

export component AppWindow inherits Window {
    property <[string]> pages: ["Performance", "Lighting", "Buttons", "Device"];
    property <bool> connected: AppState.state == MouseState.connected;
    // Controls can be used: connected and no request running.
    property <bool> idle: root.connected && !AppState.busy;
    // The page has a profile to choose (not the Device page).
    property <bool> per-profile: AppState.page < 3;

    title: AppState.demo ? "konectl (demo)" : "konectl";
    // The minimum size comes from the content, so nothing is cut off; pages
    // scroll when the window is lower than them.
    preferred-width: 1100px;
    preferred-height: 760px;
    // The minimum size the content needs (for the screenshot tool).
    out property <length> layout-min-width: self.min-width;
    out property <length> layout-min-height: self.min-height;
    background: Palette.background;

    HorizontalLayout {
        Sidebar {
            pages: root.pages;
            current <=> AppState.page;
            enabled: AppState.has-snapshot;
            headline: AppState.state == MouseState.connected ? AppState.device.connection
                : AppState.state == MouseState.asleep ? "Asleep"
                : AppState.state == MouseState.no-access ? "No access" : "Not connected";
            battery: AppState.has-snapshot ? AppState.device.battery : "";
            battery-level: AppState.has-snapshot ? AppState.device.battery-level : -1;
            detail: AppState.has-snapshot ? "Firmware " + AppState.device.firmware : "";
        }

        VerticalLayout {
            horizontal-stretch: 1;

            HorizontalLayout {
                padding: Theme.padding;
                padding-bottom: Theme.spacing;
                spacing: Theme.spacing;
                visible: AppState.has-snapshot;

                Text {
                    text: root.pages[AppState.page];
                    font-size: 22px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Undo";
                    enabled: root.idle && AppState.can-undo;
                    clicked => {
                        AppState.undo();
                    }
                }

                Button {
                    text: "Reload";
                    enabled: root.connected && !AppState.busy;
                    clicked => {
                        AppState.reload();
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.padding;
                padding-right: Theme.padding;
                padding-bottom: Theme.spacing;
                visible: AppState.has-snapshot && root.per-profile;

                ProfileBar {
                    selected: AppState.selected-profile;
                }
            }

            VerticalLayout {
                padding-left: Theme.padding;
                padding-right: Theme.padding;
                spacing: Theme.spacing;

                if AppState.has-snapshot && AppState.state == MouseState.asleep: Banner {
                    kind: BannerKind.warning;
                    text: "The mouse does not answer: move it, or switch it on. konectl connects as soon as it answers.";
                }

                if AppState.changed-elsewhere: Banner {
                    kind: BannerKind.info;
                    text: "Another program changed the mouse settings.";
                    action-text: "Reload";
                    action-enabled: root.connected && !AppState.busy;
                    action => {
                        AppState.reload();
                    }
                }

                if AppState.error != "": Banner {
                    kind: BannerKind.error;
                    text: AppState.error;
                    closable: true;
                    close => {
                        AppState.dismiss-error();
                    }
                }
            }

            // All pages exist all the time and are only hidden, so switching
            // does not change the window's size constraints. Each scrolls on
            // its own; the widest page sets the minimum width.
            Rectangle {
                vertical-stretch: 1;
                min-height: 160px;
                min-width: max(max(performance.min-width, lighting.min-width), max(buttons.min-width, device.min-width)) + 2 * Theme.padding;

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.has-snapshot && AppState.page == 0;
                    content-width: self.visible-width;
                    content-height: performance.preferred-height + Theme.spacing + Theme.padding;

                    performance := PerformancePage {
                        x: Theme.padding;
                        y: Theme.spacing;
                        width: parent.width - 2 * Theme.padding;
                        height: self.preferred-height;
                        idle: root.idle;
                    }
                }

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.has-snapshot && AppState.page == 1;
                    content-width: self.visible-width;
                    content-height: lighting.preferred-height + Theme.spacing + Theme.padding;

                    lighting := LightingPage {
                        x: Theme.padding;
                        y: Theme.spacing;
                        width: parent.width - 2 * Theme.padding;
                        height: self.preferred-height;
                        idle: root.idle;
                        shown: AppState.has-snapshot && AppState.page == 1;
                    }
                }

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.has-snapshot && AppState.page == 2;
                    content-width: self.visible-width;
                    content-height: buttons.preferred-height + Theme.spacing + Theme.padding;

                    buttons := PlaceholderPage {
                        x: Theme.padding;
                        y: Theme.spacing;
                        width: parent.width - 2 * Theme.padding;
                        height: self.preferred-height;
                        title: "Buttons";
                    }
                }

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.has-snapshot && AppState.page == 3;
                    content-width: self.visible-width;
                    content-height: device.preferred-height + Theme.spacing + Theme.padding;

                    device := DevicePage {
                        x: Theme.padding;
                        y: Theme.spacing;
                        width: parent.width - 2 * Theme.padding;
                        height: self.preferred-height;
                    }
                }

                StatePage {
                    width: parent.width;
                    height: parent.height;
                    visible: !AppState.has-snapshot && AppState.state != MouseState.no-access;
                }

                AccessPage {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.state == MouseState.no-access;
                }
            }

            CommandBar {
                visible: AppState.has-snapshot;
                commands: AppState.commands;
            }

            StatusBar {
                busy: AppState.busy;
                text: AppState.busy ? AppState.busy-text
                    : AppState.message != "" ? AppState.message
                    : AppState.state == MouseState.connected ? "Connected" : "";
                note: AppState.demo ? "Demo mode: no mouse is changed" : "";
            }
        }
    }
}
